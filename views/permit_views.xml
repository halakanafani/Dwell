<?xml version="1.0" encoding="utf-8"?>
<!--
    Permit views for the Dwell module (Odoo 19).

    Contains: list view, form view (with the DTCM workflow buttons), the window
    action, the Permits menu entry and the daily expiry job.

    Odoo 19 notes: lists use the <list> tag, and field visibility
    and read-only rules are written directly as expressions on the field
    (invisible="..." / readonly="...").

    Load order: this file must come after property_views.xml in __manifest__.py,
    because the menu below uses the parent menu "menu_dwell_root" defined there.
-->
<odoo>

    <!-- ================================================================
         List view
         Row colours: green = valid, orange = needs attention,
         red = expired / closed / rejected.
         ================================================================ -->
    <record id="view_dwell_permit_list" model="ir.ui.view">
        <field name="name">dwell.permit.list</field>
        <field name="model">dwell.permit</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'valid'"
                  decoration-warning="state in ('expiring_soon', 'suspended')"
                  decoration-danger="state in ('expired', 'closed', 'rejected')">
                <field name="name"/>
                <field name="permit_type"/>
                <field name="unit_id"/>
                <field name="manager_id"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         Form view
         ================================================================ -->
    <record id="view_dwell_permit_form" model="ir.ui.view">
        <field name="name">dwell.permit.form</field>
        <field name="model">dwell.permit</field>
        <field name="arch" type="xml">
            <form>

                <!-- Workflow buttons. Each button is only visible in the states
                     where the Permit statechart allows that transition. -->
                <header>
                    <!-- Draft: submit the application for inspection -->
                    <button name="action_submit_application" type="object" string="Submit Application"
                            class="btn-primary" invisible="state != 'draft'"/>

                    <!-- DTCM decisions: the system only records what DTCM decided -->
                    <button name="action_dtcm_valid" type="object" string="DTCM: Approved"
                            class="btn-primary"
                            invisible="state not in ('under_inspection', 'suspended', 'reopening_inspection')"/>
                    <button name="action_dtcm_rejected" type="object" string="DTCM: Rejected"
                            invisible="state != 'under_inspection'"/>
                    <button name="action_dtcm_suspended" type="object" string="DTCM: Suspended"
                            invisible="state not in ('valid', 'expiring_soon')"/>
                    <button name="action_dtcm_closed" type="object" string="DTCM: Closed"
                            invisible="state not in ('suspended', 'reopening_inspection')"/>

                    <!-- Reopening a closed permit -->
                    <button name="action_dtcm_reopen_requested" type="object" string="Reopen Requested"
                            invisible="state != 'closed'"/>
                    <button name="action_dtcm_reopening_inspection" type="object" string="Fee Paid: Reopen Inspection"
                            invisible="state != 'reopen_requested'"/>

                    <!-- Expiry handling -->
                    <button name="action_send_reminder" type="object" string="Send Reminder"
                            invisible="state != 'valid'"/>
                    <button name="action_renew" type="object" string="Renew Permit"
                            class="btn-primary" invisible="state not in ('expiring_soon', 'expired')"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,under_inspection,valid,expiring_soon,expired"/>
                </header>

                <sheet>
                    <!-- Main details. Fields are editable in the draft only; once the
                         application is submitted they are locked (see permit.py). -->
                    <group>
                        <group string="Permit">
                            <field name="name" readonly="state not in ('draft', 'under_inspection')"/>
                            <field name="permit_type" readonly="state != 'draft'"/>
                            <field name="unit_id" readonly="state != 'draft'"/>
                            <field name="manager_id" readonly="state != 'draft'"/>
                            <field name="license_info" readonly="state not in ('draft', 'under_inspection')"/>
                        </group>
                        <group string="Dates">
                            <field name="issue_date" readonly="state != 'draft'"/>
                            <field name="expiry_date" readonly="state != 'draft'"/>
                            <!-- Only shown when a renewal is possible -->
                            <field name="new_expiry_date"
                                   invisible="state not in ('expiring_soon', 'expired')"/>
                            <field name="last_dtcm_update"/>
                        </group>
                    </group>

                    <!-- Operator permits only -->
                    <group string="Operator Details" invisible="permit_type != 'operator'">
                        <group>
                            <field name="operator_license_no" readonly="state != 'draft'"/>
                            <field name="owner_authorisation_letter" filename="owner_authorisation_filename"
                                   readonly="state != 'draft'"/>
                            <field name="owner_authorisation_filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="contract_start_date" readonly="state != 'draft'"/>
                            <field name="contract_end_date" readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <!-- Notes recorded from DTCM decisions (always editable) -->
                    <group string="DTCM Remarks">
                        <field name="dtcm_remarks" nolabel="1"/>
                    </group>

                    <!-- Reminders created by the Send Reminder button and the daily job -->
                    <notebook>
                        <page string="Notifications">
                            <field name="notification_ids" readonly="1">
                                <list>
                                    <field name="sent_date"/>
                                    <field name="recipient_id"/>
                                    <field name="message"/>
                                    <field name="days_left"/>
                                    <field name="is_read"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================
         Window action and menu entry (under the Dwell root menu)
         ================================================================ -->
    <record id="action_dwell_permit" model="ir.actions.act_window">
        <field name="name">Permits</field>
        <field name="res_model">dwell.permit</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dwell_permit" name="Permits"
              parent="menu_dwell_root"
              action="action_dwell_permit" sequence="20"/>

    <!-- ================================================================
         Scheduled job
         Runs once a day: moves permits past their expiry date to Expired and
         sends reminders for permits close to expiry (_cron_check_expiry in
         permit.py).
         ================================================================ -->
    <record id="cron_dwell_permit_expiry" model="ir.cron">
        <field name="name">Dwell: Check Permit Expiry</field>
        <field name="model_id" ref="model_dwell_permit"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_expiry()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

</odoo>