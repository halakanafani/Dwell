<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Service Tasks List View -->
    <record id="view_service_tasks_list" model="ir.ui.view">
        <field name="name">service.tasks.list</field>
        <field name="model">service.tasks</field>
        <field name="arch" type="xml">
            <list string="Service Tasks">
                <field name="task_id_code"/>
                <field name="name"/>
                <field name="task_type"/>
                <field name="scheduled_date"/>
                <field name="priority"/>
                <field name="staff_id"/>
            </list>
        </field>
    </record>

    <!-- Service Tasks Form View -->
    <record id="view_service_tasks_form" model="ir.ui.view">
        <field name="name">service.tasks.form</field>
        <field name="model">service.tasks</field>
        <field name="arch" type="xml">
            <form string="Service Task">
                <sheet>
                    <group>
                        <field name="task_id_code"/>
                        <field name="name"/>
                        <field name="task_type"/>
                        <field name="staff_id"/>
                        <field name="scheduled_date"/>
                        <field name="priority"/>
                        <field name="estimated_duration"/>
                        <field name="task_cost"/>
                    </group>
                    <notebook>
                        <page string="Cleaning Details" invisible="task_type != 'cleaning'">
                            <group>
                                <field name="checklist_details"/>
                                <field name="linen_change_required"/>
                                <field name="inspection_passed"/>
                            </group>
                        </page>
                        <page string="Maintenance Details" invisible="task_type != 'maintenance'">
                            <group>
                                <field name="equipment_needed"/>
                                <field name="urgency_level"/>
                                <field name="technician_notes"/>
                            </group>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_service_tasks" model="ir.actions.act_window">
        <field name="name">Service Tasks</field>
        <field name="res_model">service.tasks</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_dwell_root" name="Dwell Management"/>
    <menuitem id="menu_service_tasks" name="Service Tasks" parent="menu_dwell_root" action="action_service_tasks" sequence="10"/>
</odoo>