<odoo>
    <data noupdate="1">
        <!-- iCal Auto-Sync Cron Job -->
        <record id="ir_cron_ical_sync" model="ir.cron">
            <field name="name">Dwell: iCal Availability Sync</field>
            <field name="model_id" ref="model_dwell_availability"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_ical_feeds()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
        </record>
    </data>
</odoo>