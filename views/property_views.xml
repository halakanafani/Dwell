<!--Ali's Part this is just a demo, pleaser refer to our use cases and classes to design this -->

<odoo>

    <record id="access_dwell_unit_manager" model="ir.model.access">
        <field name="name">dwell.unit.manager</field>
        <field name="model_id" ref="model_dwell_unit"/>
        <field name="group_id" ref="group_dwell_manager"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- List View (Changed from 'tree' to 'list' for Odoo 19) -->
    <record id="view_dwell_property_list" model="ir.ui.view">
        <field name="name">dwell.property.list</field>
        <field name="model">dwell.property</field>
        <field name="arch" type="xml">
            <list string="Properties">
                <field name="name"/>
                <field name="address"/>
                <field name="property_type"/>
                <field name="unit_count"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_dwell_property_form" model="ir.ui.view">
        <field name="name">dwell.property.form</field>
        <field name="model">dwell.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="address"/>
                            <field name="owner_id"/>
                            <field name="manager_id"/>
                        </group>
                        <group>
                            <field name="property_type"/>
                            <field name="status"/>
                        </group>
                    </group>
                    <notebook>
    <page name="units" string="Units" groups="dwell_management.group_dwell_manager">
        <field name="unit_ids">
            <list editable="bottom">
                <field name="name"/>
                <field name="unit_type"/>
                <field name="bedrooms"/>
                <field name="unit_status"/>
                <field name="has_private_pool" invisible="unit_type != 'villa'"/>
                <field name="number_of_floors" invisible="unit_type != 'villa'"/>
                <field name="building_name" string="Building Name" invisible="unit_type != 'apartment'"/>
                <field name="building_access_info" invisible="unit_type != 'apartment'"/>
            </list>
        </field>
    </page>
</notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action to open Properties view -->
    <record id="action_dwell_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">dwell.property</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Main Top Menu -->
    <menuitem id="menu_dwell_root" name="Dwell" sequence="10"/>
    
    <!-- Sub-menu under Dwell -->
    <menuitem id="menu_dwell_property" name="Properties" parent="menu_dwell_root" action="action_dwell_property"/>
</odoo>

