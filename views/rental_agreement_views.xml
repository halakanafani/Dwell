<odoo>
    <!-- List view: displays all rental agreements -->
    <record id="view_rental_agreement_list" model="ir.ui.view">
        <field name="name">dwell.rental.agreement.list</field>
        <field name="model">dwell.rental.agreement</field>
        <field name="arch" type="xml">
            <list string="Rental Agreements">
                <field name="name"/>
                <field name="guest_name"/>
                <field name="agreement_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <!-- Form view: create and edit an agreement -->
    <record id="view_rental_agreement_form" model="ir.ui.view">
        <field name="name">dwell.rental.agreement.form</field>
        <field name="model">dwell.rental.agreement</field>
        <field name="arch" type="xml">
            <form string="Rental Agreement">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="guest_name"/>
                        </group>
                        <group>
                            <field name="agreement_date"/>
                            <field name="status"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action: opens the Rental Agreements screen -->
    <record id="action_rental_agreements" model="ir.actions.act_window">
        <field name="name">Rental Agreements</field>
        <field name="res_model">dwell.rental.agreement</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- Adds Rental Agreements under the Dwell menu -->
    <menuitem
       id="menu_dwell_rental_agreements"
       name="Rental Agreements"
       parent="menu_dwell_root"
       action="action_rental_agreements"
       sequence="20"
    />
</odoo>
